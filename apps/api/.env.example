# Neon connection string. Can be either `postgres://...` or `postgresql://...`;
# the app rewrites it to `postgresql+asyncpg://...` at load time.
DATABASE_URL=postgresql://user:password@host.neon.tech/kennel?sslmode=require

# Optional override used only by pytest. When set, skips the testcontainers
# Docker dependency and runs tests against this DB instead.
# TEST_DATABASE_URL=postgresql://kennel:kennel@localhost:5432/kennel_test

APP_ENV=development
